# ==============================================================================
# FINORA AI — Root Environment Variables Template
# ==============================================================================
# Copy this file to:
#   1. frontend/.env
#   2. backend/.env
# and populate each with appropriate values.
# NEVER commit .env files containing real secret keys to source control!
# ==============================================================================

# --- Frontend Environment Variables (frontend/.env) ---
# Backend REST API endpoint
VITE_API_URL=http://localhost:5000/api

# Supabase Project URL (Dashboard -> Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Key (Dashboard -> Project Settings -> API -> anon public)
# NOTE: Use ONLY the anon key on frontend. NEVER use service_role key here!
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here


# --- Backend Environment Variables (backend/.env) ---
# Server Port & Mode
PORT=5000
NODE_ENV=development

# Allowed Client Origin (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Supabase Server-side Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Gemini API Key (Backend only - never expose in client code)
# Obtain a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
