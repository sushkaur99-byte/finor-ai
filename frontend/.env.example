# ==============================================================================
# FINORA AI — Frontend Environment Configuration
# ==============================================================================

# Backend REST API
VITE_API_URL=http://localhost:5000/api

# Supabase Project URL (Found under: Supabase Project Settings -> API -> Project URL)
# Example: https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Public Key (Found under: Settings -> API -> Project API keys -> anon / public)
# IMPORTANT: Use ONLY the anon public key. NEVER expose the service_role key here!
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here
